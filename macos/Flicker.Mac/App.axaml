<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Flicker.Mac.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#45E0C7" />
      <Setter Property="Foreground" Value="#11171E" />
    </Style>
  </Application.Styles>
</Application>
